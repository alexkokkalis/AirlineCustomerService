# Keep real secrets in .env (which is gitignored); never commit them.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Public HTTPS base URL used by ElevenLabs to call this API. Configure later.
PUBLIC_API_BASE_URL=

# Live-agent refinement safeguards. Defaults are used when these are omitted.
MAX_ITERATIONS=5
MAX_SCENARIOS_PER_RUN=3
MAX_TURNS_PER_CONVERSATION=12
MAX_TOOL_CALLS_PER_CONVERSATION=10
MAX_AGENT_CALLS_PER_RUN=40
